{
	# Pas de HTTPS ici : le proxy partagé s'en charge.
	auto_https off
	admin off
}

# oplaa.pro → l'application directement
# (les pages légales/support restent servies depuis la vitrine)
:80 {
	encode zstd gzip
	# Sécurité : pas d'affichage dans un cadre d'un autre site, pas de devinette de type, pas de fuite d'adresse
	header {
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Assistance & Confidentialité : servies depuis la vitrine (/srv/site)
	@legal path /assistance.html /confidentialite.html /cgu.html /dpa.html /mentions-legales.html /assistance /confidentialite /cgu /dpa /mentions-legales
	handle @legal {
		root * /srv/site
		@lhtml path *.html /assistance /confidentialite /cgu /dpa /mentions-legales
		header @lhtml Cache-Control "no-cache"
		try_files {path} {path}.html
		file_server
	}

	# Tout le reste → l'application web (/srv/app)
	handle {
		root * /srv/app
		@ahtml path / *.html
		header @ahtml Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# app.oplaa.pro → l'application (conservé, identique)
:8080 {
	root * /srv/app
	encode zstd gzip
	# Sécurité : pas d'affichage dans un cadre d'un autre site, pas de devinette de type, pas de fuite d'adresse
	header {
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	file_server
	@pages path / *.html
	try_files {path} /index.html
	header @pages Cache-Control "no-cache"
}
